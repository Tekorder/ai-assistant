# Copy to `.env` and fill in your values.
# NEXT_PUBLIC_DATABASE_MODE: local | dev | prod
NEXT_PUBLIC_DATABASE_MODE=local

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where lib/api.ts sends data requests. Empty on the web (same origin);
# set to the deployed server (e.g. https://your-domain) for a native build.
NEXT_PUBLIC_API_BASE_URL=

# Waldy chat — used server-side by app/api/waldy/task.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Used when mode is dev or prod (instrumentation sets DATABASE_URL from these)
DATABASE_URL_DEV=postgresql://user:password@localhost:5432/youtask
DATABASE_URL_PROD=postgresql://user:password@localhost:5432/youtask

# Optional direct URL; leave empty in local mode
DATABASE_URL=

# /admin panel password (min 8 chars). Changing it logs out every admin session.
ADMIN_PASSWORD=

# Firebase, Brevo, PlayFab, etc.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_PLAYFAB_TITLE_ID=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Firebase Admin service account — required by /api/auth/send-reset (password reset link).
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Paste the private key on one line with literal \n for line breaks, wrapped in quotes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
