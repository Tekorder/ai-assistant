generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String     @id @default(cuid())
  email                  String     @unique
  firebaseUid            String?    @unique
  name                   String?
  username               String?    @unique
  avatarUrl              String?
  timezone               String     @default("America/Tegucigalpa")
  selectedProjectLocalId String?
  onboarded              Boolean    @default(false)
  /// Starter groups (Personal, Work, Family) were added once; after that they're the user's to rename/delete
  groupsSeeded           Boolean    @default(false)
  // free | paid | perpetual. "paid" is active only while paidUntil is in the future.
  plan                   String     @default("free")
  paidUntil              DateTime?
  payments               Payment[]
  projects               Project[]
  habits                 Habit[]
  reminders              Reminder[]
  checklists             Checklist[]
  taskCompletions        TaskCompletion[]
  habitLogs              HabitLog[]
  habitMeta              HabitMeta?
  rowCreatedAt           DateTime   @default(now())
  rowUpdatedAt           DateTime   @updatedAt
}

model Project {
  id             String   @id @default(cuid())
  userId         String
  localId        String
  title          String
  isArchived     Boolean  @default(false)
  collapsed      Json     @default("{}")
  quickCollapsed Json     @default("{}")
  visibleLists   Json     @default("{}")
  /// Group order in the sidebar (the client's array index)
  position       Int      @default(0)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks         Block[]
  rowCreatedAt   DateTime @default(now())
  rowUpdatedAt   DateTime @updatedAt

  @@unique([userId, localId])
  @@index([userId])
  @@index([userId, position])
}

model Block {
  id            String   @id @default(cuid())
  projectId     String
  localId       String
  parentLocalId String?
  text          String   @default("")
  indent        Int      @default(0)
  order         Int      @default(0)
  checked       Boolean?
  deadline      String?
  /// YYYY-MM-DD the task was checked; null while open. Reports, Timeline and Calendar place
  /// done tasks by it (the due date no longer moves to the completion day)
  completedAt   String?
  /// Optional time on the due date, "HH:MM" (24h); deadline stays a plain YYYY-MM-DD
  dueTime       String?
  /// Weekdays a recurring task repeats on (0 = Sun … 6 = Sat); empty = not recurring.
  /// deadline is its current occurrence; done occurrences live in TaskCompletion.
  repeatDays    Int[]    @default([])
  /// A section divider among a list's tasks (indent 1, not a task) — only Agenda shows it
  isSection     Boolean  @default(false)
  createdAt     String?
  isHidden      Boolean  @default(false)
  archived      Boolean  @default(false)
  onHold        Boolean  @default(false)
  flag          String?
  priority      Boolean  @default(false)
  listStatus    String?
  /// Legacy single note — now mirrors the newest entry of `notes`
  note          String?
  /// Dated notes on a task, newest first: [{ id, text, date: "YYYY-MM-DD" }]
  notes         Json     @default("[]")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rowCreatedAt  DateTime @default(now())
  rowUpdatedAt  DateTime @updatedAt

  @@unique([projectId, localId])
  @@index([projectId, parentLocalId, order])
  @@index([projectId])
  @@index([deadline])
  @@index([completedAt])
  @@index([archived])
}

/// One done occurrence of a recurring task ("Gym" on 2026-10-26). An occurrence with
/// no row here is still open. Keyed by the task's localId, not Block.id — the sync
/// recreates Block rows on every save, so a FK there would wipe the history.
model TaskCompletion {
  id           String   @id @default(cuid())
  userId       String
  taskLocalId  String
  /// YYYY-MM-DD of the occurrence
  date         String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rowCreatedAt DateTime @default(now())

  @@unique([userId, taskLocalId, date])
  @@index([userId])
}

model Habit {
  id              String   @id @default(cuid())
  userId          String
  localId         String
  /// The habit's name
  text            String   @default("")
  /// Deprecated (habits v1): done-state now lives in HabitLog. Kept for the backfill; drop later.
  checked         Boolean  @default(false)
  /// Deprecated (habits v1): replaced by goalPeriod = "week". Kept for the backfill; drop later.
  weekly          Boolean  @default(false)
  description     String?
  emoji           String?
  /// Palette key (see habitColors.ts); null = the theme's accent
  color           String?
  groupName       String?
  /// build | quit
  kind            String   @default("build")
  /// day | week | month — the window goalValue has to be reached in
  goalPeriod      String   @default("day")
  /// Amount per period (build), or the most allowed (quit)
  goalValue       Float    @default(1)
  /// times | min | h | ml | km | steps | pages | any custom unit
  goalUnit        String   @default("times")
  /// Weekdays it's due (0 = Sun … 6 = Sat); empty = every day
  taskDays        Int[]    @default([])
  /// anytime | morning | afternoon | evening
  timeRange       String   @default("anytime")
  remindersOn     Boolean  @default(false)
  /// "HH:MM" (24h) times the reminder fires on due days
  reminderTimes   String[] @default([])
  reminderMessage String?
  /// Ask for a memo after checking it in
  memoOnComplete  Boolean  @default(false)
  /// What the card's button does: done (complete the goal) | add (log an amount)
  barAction       String   @default("done")
  /// bar | line
  chartType       String   @default("bar")
  /// YYYY-MM-DD; due days start here
  startDate       String?
  /// YYYY-MM-DD; null = no end
  endDate         String?
  archived        Boolean  @default(false)
  /// Template it was created from (habitTemplates.ts), if any
  templateKey     String?
  position        Int      @default(0)
  createdAt       String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rowCreatedAt    DateTime @default(now())
  rowUpdatedAt    DateTime @updatedAt

  @@unique([userId, localId])
  @@index([userId, position])
}

/// One day of one habit ("Drink water" on 2026-10-31: 1500 ml). A day with no row
/// has nothing logged. Keyed by the habit's localId, not Habit.id — the sync
/// recreates Habit rows on every save, so a FK there would wipe the history.
model HabitLog {
  id           String   @id @default(cuid())
  userId       String
  habitLocalId String
  /// YYYY-MM-DD
  date         String
  /// Amount logged that day, in the habit's goalUnit
  value        Float    @default(0)
  /// The day was skipped on purpose — doesn't count as done or missed
  skipped      Boolean  @default(false)
  memo         String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rowCreatedAt DateTime @default(now())
  rowUpdatedAt DateTime @updatedAt

  @@unique([userId, habitLocalId, date])
  @@index([userId, date])
}

model HabitMeta {
  id                 String   @id @default(cuid())
  userId             String   @unique
  /// Deprecated (habits v1 daily reset). Kept for the backfill; drop later.
  lastDailyResetYMD  String?
  /// Deprecated (habits v1 weekly reset). Kept for the backfill; drop later.
  lastWeeklyResetYMD String?
  /// How a habit is checked in: tap | swipe
  checkInMethod      String   @default("tap")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rowCreatedAt       DateTime @default(now())
  rowUpdatedAt       DateTime @updatedAt
}

model Checklist {
  id           String   @id @default(cuid())
  userId       String
  localId      String
  name         String   @default("")
  items        Json     @default("[]")
  position     Int      @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rowCreatedAt DateTime @default(now())
  rowUpdatedAt DateTime @updatedAt

  @@unique([userId, localId])
  @@index([userId, position])
}

model Reminder {
  id           String   @id @default(cuid())
  userId       String
  localId      String
  title        String   @default("")
  date         String
  time         String
  daily        Boolean  @default(false)
  /// Weekdays a daily reminder fires on (0 = Sun … 6 = Sat); empty = every day
  days         Int[]    @default([])
  position     Int      @default(0)
  flag         String?
  /// YYYY-MM-DD the user dismissed it from the bell; it counts as dismissed only on that day
  dismissedOn  String?
  createdAt    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rowCreatedAt DateTime @default(now())
  rowUpdatedAt DateTime @updatedAt

  @@unique([userId, localId])
  @@index([userId, date])
  @@index([userId, position])
}

model Payment {
  id           String   @id @default(cuid())
  userId       String
  /// Amount in cents
  amount       Int
  currency     String   @default("USD")
  paidAt       DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rowCreatedAt DateTime @default(now())

  @@index([userId])
  @@index([paidAt])
}
