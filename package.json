{
  "name": "ai-assistant",
  "version": "0.1.8",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0",
    "prebuild": "node scripts/bump-version.mjs",
    "build": "prisma generate && next build",
    "prebuild:turbo": "node scripts/bump-version.mjs",
    "build:turbo": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@azure/identity": "^4.12.0",
    "@getbrevo/brevo": "^3.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "compromise": "^14.14.5",
    "dotenv": "^17.4.2",
    "firebase": "^12.10.0",
    "firebase-admin": "^14.1.0",
    "next": "15.5.9",
    "openai": "^5.20.2",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
